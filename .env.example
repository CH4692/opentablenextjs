# Neon PostgreSQL — use the pooled URL for the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Same credentials, but WITHOUT "-pooler" in the host (for Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Long random secret used to sign JWTs
JWT_SECRET="replace-with-a-long-random-string"

# develop | production
APP_ENV="develop"

# Optional: allow /api/seed on Vercel
# ALLOW_SEED="false"
