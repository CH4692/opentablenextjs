    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "20.11.16",
    "@types/react": "18.2.52",
    "@types/react-dom": "18.2.18",
    "@types/validator": "^13.11.9",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "cookies-next": "^4.1.1",
    "eslint": "8.56.0",
    "eslint-config-next": "14.1.0",
    "jose": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^13.1.1",
    "prisma": "^5.22.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.3.3",
    "validator": "^13.11.0"
